# Copy this file to ".env" in the same folder and fill in real values.
# .env is gitignored and is loaded automatically when you start the backend.

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/weworktogether?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SUPERADMIN_EMAIL=superadmin@weworktogether.local
SUPERADMIN_PASSWORD=ChangeMe_Admin1!
SUPERADMIN_NAME=Platform Owner

# Production site. Invite and reset emails use this as the link base:
#   {FRONTEND_URL}/setup-password?token=...
# Local UI only: http://localhost:5173
FRONTEND_URL=https://weworktogether.me
CORS_ORIGINS=https://weworktogether.me,https://www.weworktogether.me,http://localhost:5173

# Frontend API target. yes = hosted URL below, no = http://localhost:8080
# Restart `npm run dev` after changing this. Production Docker builds can omit it
# and use VITE_API_BASE_URL alone.
VITE_USE_HOSTED_API=no
VITE_API_BASE_URL=https://api.weworktogether.me

# Gmail SMTP. Leave SMTP_HOST / SMTP_USERNAME blank to log invites instead of sending.
# Use a Google App Password (not your normal Gmail password). Requires 2-Step Verification:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_NAME=WeWorkTogether
# Optional inbox for landing-page inquiries (defaults to SUPERADMIN_EMAIL)
CONTACT_EMAIL=

# Firebase Cloud Messaging (push notifications)
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=weworktogether-b1d16
FIREBASE_SERVICE_ACCOUNT_PATH=weworktogether-b1d16-firebase-adminsdk-fbsvc-3de1793cd8.json

# Firebase web client (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=weworktogether-b1d16.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=weworktogether-b1d16
VITE_FIREBASE_MESSAGING_SENDER_ID=830885619499
VITE_FIREBASE_APP_ID=1:830885619499:web:c36174c0fca9103e3b476e
VITE_FIREBASE_VAPID_KEY=
