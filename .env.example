# Copy this file to ".env" in the same folder and fill in real values.
# .env is gitignored and is loaded automatically when you start the backend.

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/weworktogether?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SUPERADMIN_EMAIL=superadmin@weworktogether.local
SUPERADMIN_PASSWORD=ChangeMe_Admin1!
SUPERADMIN_NAME=Platform Owner

# Production site. Invite and reset emails use this as the link base:
#   {FRONTEND_URL}/setup-password?token=...
# Local UI only: http://localhost:5173
FRONTEND_URL=https://weworktogether.me
CORS_ORIGINS=https://weworktogether.me,https://www.weworktogether.me,http://localhost:5173

# Frontend (Vite) backend origin. Used by `npm run dev` / `npm run build` in frontend/.
VITE_API_BASE_URL=http://localhost:8080

# Gmail SMTP. Leave SMTP_HOST / SMTP_USERNAME blank to log invites instead of sending.
# Use a Google App Password (not your normal Gmail password). Requires 2-Step Verification:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_NAME=WeWorkTogether
# Optional inbox for landing-page inquiries (defaults to SUPERADMIN_EMAIL)
CONTACT_EMAIL=
